- op: add
  path: /spec/template/spec/containers/0/env/-
  value:
      name: K8S_NODE_NAME
      valueFrom:
        fieldRef:
          fieldPath: spec.nodeName
- op: add
  path: /spec/template/spec/containers/0/env/-
  value:
      name: K8S_NAMESPACE
      valueFrom:
        fieldRef:
          fieldPath: metadata.namespace
- op: add
  path: /spec/template/spec/containers/0/env/-
  value:
      name: K8S_POD_NAME
      valueFrom:
        fieldRef:
          fieldPath: metadata.name
