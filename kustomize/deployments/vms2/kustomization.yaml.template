patches:
#Change replicas
- target:
    group: apps
    version: v1
    kind: Deployment
    name: "(archive|backend|controller-.*|wb-share-player|frontend-.*|integration-wb|portal-.*|queue.*|reports|vgw-backend|embed-player)"
  patch: |-
    - op: replace
      path: /spec/replicas
      value: 2
    - op: replace
      path: /spec/strategy
      value:
        rollingUpdate:
          maxSurge: 25%
          maxUnavailable: 25%
        type: RollingUpdate
- target:
    group: apps
    version: v1
    kind: Deployment
    name: "(cron|schedule|controller-schedule)"
  patch: |-
    - op: replace
      path: /spec/replicas
      value: 1
    - op: replace
      path: /spec/strategy
      value:
        rollingUpdate:
          maxSurge: 1
          maxUnavailable: 0
        type: RollingUpdate

#Kustomizations with patch files
