datasources:
  datasources.yaml:
    apiVersion: 1
    deleteDatasources:
      - name: prometheus
        orgId: 1
      - name: influxdb
        orgId: 1
      - name: loki
        orgId: 1
    datasources:
      - name: prometheus
        type: prometheus
        uid: prometheus
        access: proxy
        orgId: 1
        url: http://prometheus-server.${NS_MONITORING}.svc:8080
        editable: true
        version: 1
      - name: influxdb
        type: influxdb
        uid: influxdb
        access: proxy
        orgId: 1
        url: http://influxdb-influxdb2.${NS_MONITORING}.svc
        editable: true
        jsonData:
          dbName: telegraf
          httpMode: GET
          httpHeaderName1: Authorization
        secureJsonData:
          httpHeaderValue1: "Token ${INFLUX_TOKEN}"
      - name: loki
        type: loki
        uid: loki
        access: proxy
        orgId: 1
        url: http://loki.${NS_MONITORING}.svc:3100
        basicAuth: false
        version: 1
        isDefault: false
        editable: true

dashboardProviders:
  dashboardproviders.yaml:
    apiVersion: 1
    providers:
      - name: 'dashboards'
        orgId: 1
        folder: ''
        type: file
        disableDeletion: false
        allowUiUpdates: true
        updateIntervalSeconds: 30
        editable: true
        options:
          path: /etc/grafana/provisioning/dashboards
          foldersFromFilesStructure: true

alerting:
  policies.yaml:
    apiVersion: 1
    policies:
      - orgId: 1
        receiver: Telegram
        group_by:
          - grafana_folder
          - alertname
        repeat_interval: 3d
      - orgId: 1
        receiver: Slack
        group_by:
          - grafana_folder
          - alertname
        repeat_interval: 3d
  contactpoints.yaml:
    secret:
      apiVersion: 1
      contactPoints:
        - orgId: 1
          name: Telegram
          receivers:
            - uid: telegram
              type: telegram
              settings:
                bottoken: "${TELEGRAM_BOT_TOKEN}"
                chatid: "${TELEGRAM_CHAT_ID}"
                parse_mode: HTML
                disable_notification: false
                disable_web_page_preview: false
                message: '{{ `{{ template "telegram-message" . }}` }}'
                protect_content: false
              disableResolveMessage: false
        - orgId: 1
          name: Slack
          receivers:
            - uid: slack
              type: slack
              settings:
                recipient: "${SLACK_CHANNEL_ID}"
                token: "${SLACK_BOT_TOKEN}"
                text: '{{ `{{ template "slack-message" . }}` }}'
              disableResolveMessage: false
  templates.yaml:
    apiVersion: 1
    templates:
      - orgId: 1
        name: telegram-alert
        template: |
          {{ `{{ define "telegram-alert" -}}
          <b>{{ .Status | toUpper }}</b>
          {{- if eq (index .Labels "alertname") "DatasourceNoData" }}
          ⚠️ DatasourceNoData
          No data from datasource
          {{- with index .Labels "rulename" }}
          Rule: {{ . }}
          {{- end }}
          {{- with index .Labels "datasource_uid" }}
          Datasource: {{ . }}
          {{- end }}
          {{- else if eq (index .Labels "alertname") "DatasourceError" }}
          ❌ DatasourceError
          Datasource query error
          {{- with index .Labels "rulename" }}
          Rule: {{ . }}
          {{- end }}
          {{- with index .Labels "datasource_uid" }}
          Datasource: {{ . }}
          {{- end }}
          {{- else }}
          {{ .Labels.alertname }}
          {{ .Annotations.summary }}
          {{- end }}
          {{- if gt (len .PanelURL) 0 }}
          <a href="{{ .PanelURL }}">Link to Grafana panel</a>
          {{- end }}
          {{ end }}` }}

      - orgId: 1
        name: slack-alert
        template: |
          {{ `{{ define "slack-alert" -}}
          *{{ .Status | toUpper }}*
          {{- if eq (index .Labels "alertname") "DatasourceNoData" }}
          ⚠️ DatasourceNoData
          No data from datasource
          {{- with index .Labels "rulename" }}
          Rule: {{ . }}
          {{- end }}
          {{- with index .Labels "datasource_uid" }}
          Datasource: {{ . }}
          {{- end }}
          {{- else if eq (index .Labels "alertname") "DatasourceError" }}
          ❌ DatasourceError
          Datasource query error
          {{- with index .Labels "rulename" }}
          Rule: {{ . }}
          {{- end }}
          {{- with index .Labels "datasource_uid" }}
          Datasource: {{ . }}
          {{- end }}
          {{- else }}
          {{ .Labels.alertname }}
          {{ .Annotations.summary }}
          {{- end }}
          {{- if gt (len .PanelURL) 0 }}
          <{{ .PanelURL }}|Link to Grafana panel>
          {{- end }}
          {{ end }}` }}
      - orgId: 1
        name: telegram-message
        template: |
          {{ `{{ define "telegram-message" }}
          Source: ${VMS_DOMAIN}
          {{ if gt (.Alerts.Firing | len) 0 }}🚨 {{ .Alerts.Firing | len }} firing alerts.
          {{ range .Alerts.Firing }} {{ template "telegram-alert" .}}

          {{ end }}
          {{ end }}
          {{ if gt (.Alerts.Resolved | len) 0 }}✅ {{ .Alerts.Resolved | len }} resolved alerts.
          {{ range .Alerts.Resolved }} {{ template "telegram-alert" .}}

          {{ end }}
          {{ end }}
          {{ end }}` }}
      - orgId: 1
        name: slack-message
        template: |
          {{ `{{ define "slack-message" }}
          Source: ${VMS_DOMAIN}
          {{ if gt (.Alerts.Firing | len) 0 }}🚨 {{ .Alerts.Firing | len }} firing alerts.
          {{ range .Alerts.Firing }} {{ template "slack-alert" .}}

          {{ end }}
          {{ end }}
          {{ if gt (.Alerts.Resolved | len) 0 }}✅ {{ .Alerts.Resolved | len }} resolved alerts.
          {{ range .Alerts.Resolved }} {{ template "slack-alert" .}}

          {{ end }}
          {{ end }}
          {{ end }}` }}

grafana.ini:
  server:
    root_url: https://${VMS_DOMAIN}/monitoring
    serve_from_sub_path: true
  ## Enable api documentation at /monitoring/swagger
  feature_toggles:
    swaggerUi: true
  log:
    level: debug

extraInitContainers:
  - name: download-dashboards
    image: download.aipix.ai:8443/minio:latest
    command: ["/bin/sh", "-c"]
    args:
      - |
        mc alias set local http://minio.${NS_MINIO}.svc${S3_PORT_INTERNAL} ${MINIO_GRAFANA_ACCESS_KEY} ${MINIO_GRAFANA_SECRET_KEY}
        mc cp --recursive local/${MINIO_GRAFANA_BUCKET_NAME}/dashboards/ /mnt/dashboards
        mc cp --recursive local/${MINIO_GRAFANA_BUCKET_NAME}/alerts/rules/ /mnt/alerting
    volumeMounts:
      - name: storage
        mountPath: /var/lib/grafana
      - name: alerts
        mountPath: /mnt/alerting
      - name: dashboards
        mountPath: /mnt/dashboards

extraVolumeMounts:
  - name: alerts
    mountPath: /etc/grafana/provisioning/alerting
  - name: dashboards
    mountPath: /etc/grafana/provisioning/dashboards

extraVolumes:
  - name: alerts
    emptyDir: {}
  - name: dashboards
    emptyDir: {}

persistence:
  type: pvc
  enabled: true
  storageClassName: ${RWO_STORAGE}
  accessModes:
    - ReadWriteOnce
  size: 10Gi

initChownData:
  ## If false, data ownership will not be reset at startup
  ## This allows the grafana-server to be run with an arbitrary user
  ##
  enabled: false

# Administrator credentials when not using an existing secret (see below)
adminUser: admin
adminPassword: admin

service:
  annotations:
    prometheus.io/scrape: "true"
    prometheus.io/port: "3000"

testFramework:
  enabled: false

resources:
  limits:
    memory: "1Gi"
    cpu: "1000m"
  requests:
    memory: 500M
    cpu: "500m"

image:
  pullSecrets:
    - download-aipix-ai