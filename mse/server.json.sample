{
  "dns": {
    "workers": 1,
    "poll": 64
  },
  "dvr": {
    "workers": 6,
    "poll": 1024
  },
  "camera": {
    "workers": 6,
    "poll": 1024
  },
  "proxy": {
    "listen": "*:8776:/",
    "poll": 1024,
    "ip": 4,
    "ssl": true,
    "workers": 1,
    "max-response-size": 65536,
    "max-request-size": 65536
  },
  "onvif": {
    "listen": "*:8887:/",
    "workers": 4,
    "poll": 1024,
    "ip": 4
  },
  "rtsp": {
    "listen": "*:8554:/",
    "sink": "*:8998:/",
    "workers": 6,
    "poll": 1024,
    "ip": 4
  },
  "cameras": "./cameras.json",
  "media": {
    "listen": "*:8443:/",
    "ip": 4,
    "workers": 4,
    "poll": 1024,
    "ssl": true
  },
  "api": {
    "listen": "*:8665:/api/",
    "workers": 2,
    "poll": 1024,
    "ssl": true,
    "ip": 4
  },
  "webui": {
    "listen": "*:9665:/",
    "path": "/opt/vsaas/services/webui",
    "workers": 1,
    "poll": 1024,
    "ssl": true,
    "routes": [
      "streams",
      "server",
      "cluster"
    ],
    "ip": 4
  },
  "ssl": {
    "key": "/opt/ssl/key.pem",
    "cert": "/opt/ssl/cert.pem"
  },
  "cluster": {
    "webhook": "http://localhost/controller/api/v1/mse/callback",
    "events": [
      "service:up",
      "service:down",
      "service:pulse",
      "service:emergency",
      "stream:create",
      "stream:state",
      "stream:reconnect",
      "stream:delete",
      "stream:pulse",
      "stream:dvr",
      "stream:dvr:delete",
      "server:capture",
      "server:release",
      "camera:create",
      "camera:delete",
      "camera:event",
      "onvif:create",
      "onvif:delete"
    ]
  },
  "license": "<url or path to license files>",
  "secret": "I9REYLxj*YCG44hvEKjXP(b5TCh)xmFxZPN+Dxuwfw2*tkRxnLQH6nuPMv#99@8e",
  "max-fd-limit": 4096,
  "hostname": "example.com",
  "ip": "192.168.0.1",
  "storage": {
    "localfs/storage": {
      "max-io-events": 1024,
      "writers": 4,
      "readers": 2,
      "max-read-events": 4096,
      "gc": {
        "timestart": "02:00:00",
        "limit": "5h",
        "period": "1d",
        "max-age": "31d"
      }
    },
    "#s3/my-bucket": {
      "endpoint": "https://s3.amazonaws.com:443",
      "access-key": "XXX",
      "secret-key": "XXX",
      "region": "us-east-1",
      "tls-verify": true,
      "cache-dir": "/tmp/vsaas/s3cache",
      "cache-size": "1G",
      "staging-dir": "/tmp/vsaas/s3staging",
      "staging-size": "100G",
      "max-connections": 64,
      "max-retry-chunks": 1,
      "max-io-events": 1024,
      "writers": 4,
      "readers": 2
    }
  },
  "log": {
    "#stdout": {
      "tag": "media-server",
      "verbose": 5,
      "pattern": "[%AppId] [%Timestamp] [%Verbose] %Message"
    },
    "file": {
      "tag": "media-server",
      "verbose": 4,
      "pattern": "[%Timestamp] [%AppId] [%Verbose] %Message",
      "path": "/var/log/vsaas/media-server.log",
      "errpath": "/var/log/vsaas/media-server.err",
      "rotate": 200000000,
      "number": 5
    },
    "#remote": {
      "tag": "media-server",
      "verbose": 3,
      "pattern": "{\"tag\":\"%Tag\",\"verbose\":\"%Verbose\",\"timestamp\":\"%Timestamp\",\"app_id\":\"%AppId\",\"message\":\"%EscMessage\"}",
      "url": "udp://company.com:8109"
    },
    "#syslog": {
      "tag": "media-server",
      "verbose": 5,
      "pattern": "[%Timestamp] [%AppId] [%Verbose] %Message",
      "facility": "user"
    }
  }
}